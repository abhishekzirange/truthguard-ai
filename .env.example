# TruthGuard AI — Environment Configuration Example
# Copy this file to .env and configure your local environment values.

# Database URL:
# PostgreSQL (Docker / server): postgresql://truthguard:truthguard_secure_password@localhost:5432/truthguard
# SQLite (zero-setup local fallback): sqlite:///./truthguard.db
DATABASE_URL=sqlite:///./truthguard.db

# Tavily Search API Key (https://tavily.com)
# Required for LIVE web verification; leave empty to run strictly in OFFLINE fallback mode.
TAVILY_API_KEY=

# Backend Server & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Verification Pipeline Defaults
DEFAULT_VERIFICATION_DEPTH=standard
DEFAULT_FRESHNESS_POLICY=standard
MAX_CLAIMS_PER_RUN=10
SEARCH_RESULTS_PER_CLAIM=5
SEARCH_CACHE_TTL_HOURS=24

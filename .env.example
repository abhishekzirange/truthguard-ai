# TruthGuard AI — Environment Configuration Example
# Copy this file to .env and configure your keys

# Database: PostgreSQL (recommended for production/Docker) or SQLite (for quick zero-setup local dev)
# Docker Compose default: postgresql://truthguard:truthguard@db:5432/truthguard
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/truthguard
# Local SQLite fallback: sqlite:///./truthguard.db
DATABASE_URL=sqlite:///./truthguard.db

# Tavily Live Search API Key (https://tavily.com)
TAVILY_API_KEY=

# Bifrost AI Gateway Configuration (OpenAI-compatible gateway)
BIFROST_BASE_URL=https://api.bifrost.ai/v1
BIFROST_API_KEY=
BIFROST_MODEL=gpt-4o-mini

# Server & Networking
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Verification Engine Defaults
DEFAULT_VERIFICATION_DEPTH=standard
DEFAULT_FRESHNESS_POLICY=standard
MAX_CLAIMS_PER_RUN=10
SEARCH_RESULTS_PER_CLAIM=5
SEARCH_CACHE_TTL_HOURS=24
